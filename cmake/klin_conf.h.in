/* Generated by Klin's CMake build from cmake/klin_conf.h.in.
 * Equivalent of the klin_conf.h written by the MaKL configure script. */
#ifndef _KLIN_CONF_H_
#define _KLIN_CONF_H_

#define KLIN_VERSION "@PROJECT_VERSION@"
#define KLIN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define KLIN_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define KLIN_VERSION_TEENY @PROJECT_VERSION_PATCH@

#cmakedefine OS_UNIX 1
#cmakedefine OS_WIN 1

/* platform checks */
#cmakedefine HAVE_STDINT 1
#cmakedefine HAVE_GETOPT 1
#cmakedefine HAVE_UNISTD 1
#cmakedefine HAVE_SYS_SELECT 1
#cmakedefine HAVE_SYS_WAIT 1
#cmakedefine HAVE_SYS_DIR 1
#cmakedefine HAVE_SYS_SOCKET 1
#cmakedefine HAVE_LOG_PERROR 1
#cmakedefine HAVE_SA_RESTART 1
#cmakedefine HAVE_TCP_NODELAY 1
#cmakedefine HAVE_PID_T 1
#cmakedefine HAVE_STRUCT_TM_TM_GMTOFF 1
#cmakedefine HAVE_FORK 1
#cmakedefine VA_LIST_BY_VALUE 1
#cmakedefine HAVE_SYSLOG 1
#cmakedefine HAVE_MKSTEMP 1
#cmakedefine HAVE_LOCALTIME_R 1
#cmakedefine HAVE_INLINE 1

/* features */
#cmakedefine ENABLE_SUP_FS 1
#cmakedefine ENABLE_SUP_CGI 1
#cmakedefine ENABLE_HOOKS 1
#cmakedefine INSTALL_DAEMON_ONLY 1

/* libraries */
#cmakedefine HAVE_LIBOPENSSL 1
#cmakedefine HAVE_LIBZ 1
#cmakedefine SSL_ON 1
#cmakedefine SSL_OPENSSL 1

/* installation directories */
#define DESTDIR "@CMAKE_INSTALL_PREFIX@"
#define BINDIR "@KLIN_FULL_BINDIR@"
#define SBINDIR "@KLIN_FULL_SBINDIR@"
#define CONFDIR "@KLIN_FULL_SYSCONFDIR@"
#define INCDIR "@KLIN_FULL_INCLUDEDIR@"
#define LIBDIR "@KLIN_FULL_LIBDIR@"
#define SHLIBDIR "@KLIN_FULL_LIBDIR@"
#define LIBEXDIR "@KLIN_FULL_LIBEXECDIR@"
#define VARDIR "@KLIN_FULL_LOCALSTATEDIR@"
#define SHAREDIR "@KLIN_FULL_DATADIR@"
#define MANDIR "@KLIN_FULL_MANDIR@"
#define DOCDIR "@KLIN_FULL_DOCDIR@"

#endif /* !_KLIN_CONF_H_ */
