# clang-tidy for Klin's own code (src/, klin/; LibU is not checked). Run by
# .github/workflows/analysis.yml; doc/FUZZING, STATIC ANALYSIS.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.insecureAPI.strcpy,
  -clang-analyzer-optin.performance.Padding,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-macro-parentheses,
  -bugprone-assignment-in-if-condition,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-branch-clone,
  -bugprone-multi-level-implicit-pointer-conversion,
  cert-err34-c,
  cert-flp30-c,
  cert-msc30-c,
  cert-msc50-cpp
HeaderFilterRegex: '(src|klin)/'
# the analyzer's bug checks fail the job; the rest is listed in its summary
WarningsAsErrors: 'clang-analyzer-core.*,clang-analyzer-unix.*,clang-analyzer-security.*,clang-analyzer-valist.*'
