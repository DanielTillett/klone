/* Generated by Klin's CMake build from cmake/libu_conf.h.in.
 * Equivalent of the libu_conf.h written by LibU's MaKL configure script. */
#ifndef _LIBU_CONF_H_
#define _LIBU_CONF_H_

#define LIBU_VERSION "@LIBU_VERSION@"
#define LIBU_VERSION_MAJOR @LIBU_VERSION_MAJOR@
#define LIBU_VERSION_MINOR @LIBU_VERSION_MINOR@
#define LIBU_VERSION_TEENY @LIBU_VERSION_TEENY@

#cmakedefine OS_UNIX 1
#cmakedefine OS_WIN 1
#cmakedefine OS_LINUX 1
#cmakedefine OS_DARWIN 1
#cmakedefine RB_INHIBIT_MMAP 1
#define U_PATH_SEPARATOR @LIBU_PATH_SEPARATOR@

/* types */
#cmakedefine HAVE_LONG_DOUBLE 1
#cmakedefine HAVE_LONG_LONG 1
#cmakedefine HAVE_INTMAX_T 1
#cmakedefine HAVE__BOOL 1
#cmakedefine HAVE_FLOAT__COMPLEX 1
#cmakedefine HAVE_DOUBLE__COMPLEX 1
#cmakedefine HAVE_LONG_DOUBLE__COMPLEX 1
#cmakedefine HAVE_PID_T 1
#cmakedefine HAVE_SSIZE_T 1
#cmakedefine HAVE_SOCKLEN_T 1
#cmakedefine HAVE_IN_ADDR_T 1
#cmakedefine HAVE_STRUCT_RUSAGE 1

/* symbols */
#cmakedefine HAVE_TCP_NODELAY 1
#cmakedefine HAVE_INET_ADDRSTRLEN 1
#cmakedefine HAVE_SO_BROADCAST 1
#cmakedefine HAVE_MAP_FIXED 1

/* functions */
#cmakedefine HAVE_DAEMON 1
#cmakedefine HAVE_SETSOCKOPT 1
#cmakedefine HAVE_GETSOCKOPT 1
#cmakedefine HAVE_GETPID 1
#cmakedefine HAVE_LINK 1
#cmakedefine HAVE_UNLINK 1
#cmakedefine HAVE_SLEEP 1
#cmakedefine HAVE_MKSTEMPS 1
#cmakedefine HAVE_SETENV 1
#cmakedefine HAVE_MMAP 1
#cmakedefine HAVE_FCNTL 1
#cmakedefine HAVE_SYSCONF 1
#cmakedefine HAVE_GETPAGESIZE 1
#cmakedefine HAVE_FNMATCH 1
#cmakedefine HAVE_STRTOK_R 1
#cmakedefine HAVE_STRSEP 1
#cmakedefine HAVE_STRLCPY 1
#cmakedefine HAVE_STRLCAT 1
#cmakedefine HAVE_STRTOD 1
#cmakedefine HAVE_GETTIMEOFDAY 1
#cmakedefine HAVE_TIMEGM 1
#cmakedefine HAVE_SYSLOG 1
#cmakedefine HAVE_VSYSLOG 1
#cmakedefine HAVE_STRTOUMAX 1
#cmakedefine HAVE_GETADDRINFO 1
#cmakedefine HAVE_UNAME 1
#cmakedefine HAVE_FORK 1
#cmakedefine HAVE_WAIT3 1
#cmakedefine HAVE_WAIT 1
#cmakedefine HAVE_SIGACTION 1
#cmakedefine HAVE_SETITIMER 1
#cmakedefine HAVE_ISFINITE 1

/* headers */
#cmakedefine HAVE_COMPLEX 1
#cmakedefine HAVE_UNISTD 1
#cmakedefine HAVE_STDLIB 1
#cmakedefine HAVE_PATHS 1
#cmakedefine HAVE_SYSUIO 1
#cmakedefine HAVE_STRINGS 1
#cmakedefine HAVE_SYS_SOCKET 1
#cmakedefine HAVE_NETINET_IN 1
#cmakedefine HAVE_NETINET_TCP 1
#cmakedefine HAVE_NETINET_SCTP 1

/* misc */
#cmakedefine HAVE_TMZONE 1
#cmakedefine HAVE_OPTARG 1
#cmakedefine HAVE_OPTIND 1
#cmakedefine HAVE_INLINE 1

/* networking */
#cmakedefine HAVE_STRUCT_SOCKADDR_IN 1
#cmakedefine HAVE_STRUCT_SOCKADDR_IN6 1
#cmakedefine HAVE_STRUCT_SOCKADDR_UN 1
#cmakedefine NO_IPV6 1
#cmakedefine NO_UNIXSOCK 1
#cmakedefine NO_SCTP 1

/* Klin builds LibU without docs and with the 1.X compatibility layer */
#define NO_DOCS 1
#define LIBU_1X_COMPAT 1

#endif /* !_LIBU_CONF_H_ */
